<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      El servidor del rally corre en la red local por HTTP (sin certificado).
      Se permite tráfico en claro para que la app pueda abrirlo. Si publicas el
      tablero en un sitio con HTTPS, esta regla no estorba.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
